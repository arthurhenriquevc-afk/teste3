{
  "name": "union3d-institucional",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
